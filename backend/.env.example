# Copy to backend/.env (git-ignored) and fill in. Never commit real keys.
# Meta Model API (dev.meta.ai), OpenAI-compatible chat completions. Recommended values:
#   FAILURELAB_LLM_MODEL=muse-spark-1.3
#   FAILURELAB_LLM_BASE_URL=https://api.meta.ai/v1
# The key comes from the API keys page of your dev.meta.ai project.
FAILURELAB_LLM_PROVIDER=meta
FAILURELAB_LLM_API_KEY=
FAILURELAB_LLM_MODEL=
FAILURELAB_LLM_BASE_URL=
# Seconds before a model call counts as failed and falls back to info_gain.
FAILURELAB_LLM_TIMEOUT_S=60
# minimal | low | medium | high | xhigh (Muse Spark always reasons).
FAILURELAB_LLM_REASONING_EFFORT=low
# Optional built dashboard directory for a single-origin deployment.
# python scripts/tasks.py serve sets this automatically for local use.
# FAILURELAB_FRONTEND_DIR=/absolute/path/to/frontend/dist
